# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (e.g. gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Path configuration for Local (macOS) vs Production (Linux Server)
# สำหรับ Local บน macOS:
HOST_LOG_PATH=./data/mock_access.log
LOG_FILE=/app/data/mock_access.log

# สำหรับ Production Server จริง (เปิดใช้บรรทัดล่างนี้แทนเมื่อ Deploy จริง):
# HOST_LOG_PATH=/var/log/nginx/cs_ssl_access.log
# LOG_FILE=/var/log/nginx/cs_ssl_access.log

OUTPUT_JSON=/app/data/security-data.json
